__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
wheels/
sdist/
develop-eggs/
.eggs/
lib/
lib64/
parts/
var/
.installed.cfg
MANIFEST

# virtual environments
.venv/
venv/
env/
ENV/
.env
.env.local
.env.*.local
.python-version.local

# type checkers & linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.ruff_cache/
.pytype/
pyrightconfig.json
cython_debug/

# testing
.pytest_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
