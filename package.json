{
  "name": "audio-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:cli": "esbuild src/cli/renderMidi.ts --bundle --platform=node --target=node18 --format=esm --external:@resvg/resvg-js --outfile=dist-cli/render-midi.mjs",
    "render": "npm run build:cli --silent && node dist-cli/render-midi.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "validate": "npm run lint && npm run coverage && npm run build",
    "bundle:soundfonts": "node scripts/bundle-soundfonts.mjs",
    "bundle:soundfonts:verify": "node scripts/bundle-soundfonts.mjs --verify",
    "prepare": "sh hooks/install.sh 2>/dev/null || true"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tonejs/midi": "^2.0.28",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.160.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
