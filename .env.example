# Copy to .env and fill in real values. Never commit .env itself.
# See .gitignore line 143.

# ── App ───────────────────────────────────────────────────────────────────────
# APP_ENV=development
# APP_PORT=3000
# LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Auth / Secrets ────────────────────────────────────────────────────────────
# API_KEY=changeme
# JWT_SECRET=changeme
